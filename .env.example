# Yomi-Subs v2 — environment variable reference
#
# The extension stores the OpenAI API key in chrome.storage.sync (set via the
# Settings tab in the popup), so you do NOT need a .env file for normal use.
#
# This file documents variables that may be used by future scripts or CI.
# Copy to .env and fill in values — never commit the real .env file.

# OpenAI API key — only needed if using OpenAI Whisper API mode.
# Set this in the extension popup instead; it's listed here for reference only.
OPENAI_API_KEY=sk-...

# Optional: override the WebSocket port (default 8765)
YOMI_WS_PORT=8765

# Optional: Whisper model size (tiny / base / small / medium / large-v3)
# Larger = more accurate but slower and requires more RAM/VRAM
WHISPER_MODEL=small
