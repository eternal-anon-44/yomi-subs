#!/usr/bin/env bash
# Yomi-Subs v2 macOS launcher

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Prefer backend embedded in the app bundle (DMG / Applications install).
# Fall back to the dev-tree location for running straight from the repo.
RESOURCES_BACKEND="$SCRIPT_DIR/../Resources/backend"
DEV_BACKEND="$(cd "$SCRIPT_DIR/../../.." && pwd)/yomi-subs-backend"

if [ -f "$RESOURCES_BACKEND/server.py" ]; then
  BACKEND_DIR="$RESOURCES_BACKEND"
elif [ -f "$DEV_BACKEND/server.py" ]; then
  BACKEND_DIR="$DEV_BACKEND"
else
  BACKEND_DIR=""
fi

# Venv lives in Application Support so it survives app updates and
# works regardless of whether the .app is in a read-only DMG or /Applications.
VENV_DIR="$HOME/Library/Application Support/YomiSubs/venv"

# ── Terminal guard ────────────────────────────────────────────────────────────
# When double-clicked, macOS runs this script outside any terminal (TERM_PROGRAM
# is unset). Open a Terminal window that re-runs this script, then exit — if we
# don't exit here the outer process would also pass the guard below and run a
# second copy, and each Terminal invocation would open yet another window.
if [ -z "$TERM_PROGRAM" ]; then
  open -a Terminal "$0"
  exit 0
fi

# ── Everything below runs inside the Terminal window ──────────────────────────

echo ""
echo "  字 Yomi-Subs v2"
echo "  ─────────────────────────────────────────"

if [ -z "$BACKEND_DIR" ]; then
  echo "  ✗ Backend not found."
  echo "    Expected: $RESOURCES_BACKEND/server.py"
  echo "           or $DEV_BACKEND/server.py"
  read -r -p "  Press Return to close…"
  exit 1
fi

if ! command -v python3 &>/dev/null; then
  echo "  ✗ python3 not found."
  echo "    Install Python 3.9+ from https://python.org or via Homebrew:"
  echo "      brew install python"
  read -r -p "  Press Return to close…"
  exit 1
fi

PY_VER=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')")
echo "  ✓ Python $PY_VER"

if [ ! -f "$VENV_DIR/bin/activate" ]; then
  echo "  → Creating virtual environment (first run only)…"
  mkdir -p "$VENV_DIR"
  python3 -m venv "$VENV_DIR"
fi

# shellcheck disable=SC1091
source "$VENV_DIR/bin/activate"

echo "  → Checking dependencies…"
pip install -q -r "$BACKEND_DIR/requirements.txt"
echo "  ✓ Dependencies ready"

echo "  → Starting Yomi-Subs backend (ws://localhost:8765)…"
echo ""
python3 "$BACKEND_DIR/server.py"

echo ""
read -r -p "  Server stopped. Press Return to close…"
